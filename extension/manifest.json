{
  "manifest_version": 3,
  "name": "YouTube 单句字幕翻译",
  "version": "1.5.1",
  "description": "收集并翻译完整的 YouTube 字幕句子，自动暂停视频并支持单词详解。",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-caption-source.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "caption-assembler.js",
        "display-settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-current-caption": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "翻译当前 YouTube 字幕"
    }
  },
  "action": {
    "default_title": "翻译当前 YouTube 字幕"
  }
}
